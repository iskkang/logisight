{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["collectors/**/*", "generators/**/*", "publishers/**/*", "lib/**/*", "scripts/**/*"]
}
