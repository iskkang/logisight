# Logisight Pipeline 환경변수 예시
# .env.local 에 복사해서 실제 값 입력 (절대 git 커밋 금지)

# Supabase — service_role (파이프라인 쓰기 전용, 절대 프론트에 노출 금지)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-api03-xxxx

# 이메일 발송 (Resend)
RESEND_API_KEY=re_xxxx

# Resend 웹훅 서명 시크릿 (Supabase Edge Function 시크릿으로도 등록 필요 — resend-webhook)
# Resend 대시보드 > Webhooks 에서 발급. 미설정 시 웹훅을 전량 거부한다(지표 위조 방지).
RESEND_WEBHOOK_SECRET=whsec_xxxx

# 브랜드 분리용 — 미설정 시 현행 값 유지(동작 불변).
# Logisight를 MTL 도메인에서 떼어낼 때 DNS/Resend 발신 도메인 검증 후 값만 바꾸면 된다.
# NEWSLETTER_FROM=Logisight <newsletter@logisight.com>
# SITE_URL=https://logisight.com

# 수신 이메일 (테스트용)
INTERNAL_EMAIL=info@mtlb.co.kr
SEND_TO=your-email@example.com

# Unsplash 이미지 API (선택사항)
UNSPLASH_ACCESS_KEY=your-unsplash-key

# MTL Link 라이브 트래킹 API (현재 무인증)
TRACKING_API_URL=https://link.mtlship.com/api/tcr?action=list
# TRACKING_API_TOKEN=

# KOSIS (통계청) — 한국 항만 컨테이너 처리실적
# 키 없이 빈 값으로도 공개 API 호출 가능 (apiKey= 파라미터 전송)
KOSIS_API_KEY=

# Slack 알림 (선택사항)
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx
