# Logisight 환경변수 예시 (.env.local 에 복사해서 실제 값 입력)

# Resend 이메일 발송
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# 수신 이메일 (테스트용 — 본인 이메일)
INTERNAL_EMAIL=your@email.com
SEND_TO=your@email.com

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxxxxxx

# Supabase — frontend (VITE_ prefix 필수, anon key만)
VITE_SUPABASE_URL=https://hmgbvqczmyjixkqbruzp.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase — backend/workers/Edge Functions (service_role key)
SUPABASE_URL=https://hmgbvqczmyjixkqbruzp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Unsplash 이미지 API
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Slack 알림 (선택사항)
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx
