{
  "name": "logisight-pipeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "collect:all": "npx tsx collectors/index.ts",
    "collect:shipping": "npx tsx collectors/index.ts shipping",
    "collect:news": "npx tsx collectors/index.ts news",
    "collect:tracing": "npx tsx collectors/tracing_ingest.ts",
    "collect:live": "npx tsx collectors/tracing_live.ts",
    "collect:tsr": "npx tsx collectors/tracing_fesco.ts",
    "collect:tcr:current": "npx tsx collectors/tracing_tcr_current.ts",
    "collect:rail:daily": "npx tsx collectors/index.ts rail-daily",
    "collect:rail:weekly": "npx tsx collectors/index.ts rail-weekly",
    "collect:ocean:daily": "npx tsx collectors/index.ts ocean-daily",
    "collect:ocean:weekly": "npx tsx collectors/index.ts ocean-weekly",
    "curate:rail": "node generators/web/curate-rail.js",
    "curate:ocean": "node generators/web/curate-ocean.js",
    "curate:air": "node generators/web/curate-air.js",
    "curate:trade": "node generators/web/curate-trade.js",
    "collect:air:daily": "npx tsx collectors/index.ts air-daily",
    "collect:policy:daily": "npx tsx collectors/index.ts policy-daily",
    "collect:logistics:daily": "npx tsx collectors/index.ts logistics-daily",
    "curate:logistics": "node generators/web/curate-logistics.js",
    "newsletter:generate": "node generators/email/generate-newsletter.js",
    "newsletter:from-site": "node generators/email/generate-newsletter-from-site.js",
    "test:email": "node --test generators/email/",
    "article:corp": "node generators/web/generate-article-corp.js",
    "article:brief": "node generators/email/generate-article-brief.js",
    "article:weekly": "node generators/email/generate-article-brief.js --window=7",
    "article:trend": "node generators/email/generate-article-brief.js --type=trend",
    "publish:curated": "node generators/web/publish-curated-to-site.js",
    "weekly:briefing": "node generators/web/generate-weekly-briefing.js",
    "generate:forecasts": "node generators/web/forecast/generate.js",
    "adjudicate:forecasts": "node generators/web/forecast/adjudicate.js",
    "forecast:drewry": "node generators/web/forecast/persist-drewry.js",
    "forecast:iata-fuel": "node generators/web/forecast/persist-iata-fuel.js",
    "forecast:diversion": "node generators/web/forecast/persist-diversion.js",
    "test:forecast": "node --test generators/web/forecast/",
    "forecast:smoke": "node generators/web/forecast/smoke-assemble.js",
    "generate:climate": "node generators/web/climate/generate.js",
    "test:climate": "node --test generators/web/climate/",
    "judge:impact": "node generators/web/impact/judge.js",
    "test:impact": "node --test generators/web/impact/",
    "backfill:news": "node scripts/backfill-maritime-news.js",
    "backfill:news:images": "node scripts/backfill-maritime-news.js --images",
    "backfill:news:internal-images": "node scripts/backfill-maritime-news.js --internal-images",
    "brief:generate": "node generators/email/generate-brief.js",
    "report:cadi": "node generators/report/generate-cadi-report.js",
    "report:weekly": "node generators/report/generate-cadi-weekly.js",
    "disruption:add": "node generators/report/add-disruption.js",
    "pdf": "node generators/report/generate-pdf.js",
    "daily:collect": "npm run collect:rail:daily && npm run collect:ocean:daily",
    "daily:curate": "npm run curate:rail && npm run curate:ocean",
    "daily:email": "npm run daily:collect && npm run daily:curate && npm run newsletter:generate",
    "daily:web": "npm run collect:rail:daily && npm run collect:ocean:daily && npm run collect:air:daily && npm run collect:policy:daily && npm run collect:logistics:daily && npm run curate:rail && npm run curate:ocean && npm run curate:air && npm run curate:trade && npm run curate:logistics && npm run publish:curated",
    "generate:article:brief": "node generators/email/generate-article-brief.js",
    "generate:article:corp": "node generators/web/generate-article-corp.js",
    "collect:monthly": "npx tsx collectors/index.ts monthly-analysis",
    "monthly:generate": "node generators/report/generate-monthly-analysis.js",
    "monthly:all": "npm run collect:monthly && npm run monthly:generate",
    "report:monthly": "node generators/report/generate-monthly-analysis.js",
    "monthly:full": "npm run collect:monthly && npm run report:monthly",
    "section:run": "node generators/report/run-section.js",
    "section:all": "node generators/report/run-section.js --all",
    "monthly:assemble": "node generators/report/assemble-monthly-report.js",
    "monthly:pdf": "node generators/report/monthly-report-pdf.js",
    "weekly-report:generate": "node generators/weekly-report/generate-weekly-report.js",
    "weekly-report:pdf": "node generators/weekly-report/weekly-report-pdf.js",
    "weekly-report:publish": "node generators/weekly-report/publish-weekly-report.js",
    "monthly:pipeline": "npm run collect:monthly && npm run section:all",
    "kita:sea": "node generators/report/lib/kita-fare.js --force",
    "kita:air": "node generators/report/lib/kita-fare.js --air --force",
    "kita:sea:push": "node generators/report/lib/kita-fare.js --force --push",
    "kita:air:push": "node generators/report/lib/kita-fare.js --air --force --push",
    "kita:all:push": "npm run kita:sea:push && npm run kita:air:push",
    "rates-brief:generate": "node generators/web/rates-brief/generate-rates-brief.js",
    "lint": "eslint collectors generators scripts --ext ts,js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@extractus/article-extractor": "^8.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^3.3.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0",
    "marked": "^14.1.4",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^24.43.1",
    "resend": "^3.5.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "eslint": "^8.56.0",
    "playwright": "^1.42.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0"
  }
}
