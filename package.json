{
  "name": "logisight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "collect:all": "ts-node --project tsconfig.workers.json workers/collectors/index.ts",
    "collect:shipping": "ts-node --project tsconfig.workers.json workers/collectors/index.ts shipping",
    "collect:news": "ts-node --project tsconfig.workers.json workers/collectors/index.ts news",
    "collect:tracing": "ts-node --project tsconfig.workers.json workers/collectors/tracing_ingest.ts",
    "collect:live": "ts-node --project tsconfig.workers.json workers/collectors/tracing_live.ts",
    "collect:tsr": "ts-node --project tsconfig.workers.json workers/collectors/tracing_fesco.ts",
    "brief:generate": "node scripts/generate-brief.js",
    "report:cadi": "node scripts/generate-cadi-report.js",
    "report:weekly": "node scripts/generate-cadi-weekly.js",
    "disruption:add": "node scripts/add-disruption.js",
    "pdf": "node scripts/generate-pdf.js",
    "lint": "eslint src --ext ts,tsx",
    "collect:rail:daily": "ts-node --project tsconfig.workers.json workers/collectors/index.ts rail-daily",
    "collect:rail:weekly": "ts-node --project tsconfig.workers.json workers/collectors/index.ts rail-weekly",
    "collect:ocean:daily": "ts-node --project tsconfig.workers.json workers/collectors/index.ts ocean-daily",
    "collect:ocean:weekly": "ts-node --project tsconfig.workers.json workers/collectors/index.ts ocean-weekly",
    "curate:rail": "node scripts/curate-rail.js",
    "curate:ocean": "node scripts/curate-ocean.js",
    "newsletter:generate": "node scripts/generate-newsletter.js",
    "article:rail": "node scripts/generate-article-shipping.js --section=rail",
    "article:ocean": "node scripts/generate-article-shipping.js --section=ocean",
    "article:corp": "node scripts/generate-article-corp.js",
    "article:brief": "node scripts/generate-article-brief.js",
    "article:weekly": "node scripts/generate-article-brief.js --window=7",
    "article:trend": "node scripts/generate-article-brief.js --type=trend",
    "publish:curated": "node scripts/publish-curated-to-site.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^3.3.0",
    "dotenv": "^17.4.2",
    "i18next": "^23.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.10.0",
    "resend": "^3.5.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "playwright": "^1.42.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0",
    "vite": "^5.1.0"
  }
}
