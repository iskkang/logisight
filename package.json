{
  "name": "logisight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "collect:all": "ts-node --project tsconfig.workers.json workers/collectors/index.ts",
    "collect:shipping": "ts-node --project tsconfig.workers.json workers/collectors/shipping_indices.ts",
    "collect:news": "ts-node --project tsconfig.workers.json workers/collectors/news_global.ts",
    "pdf": "node scripts/generate-pdf.js",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^3.3.0",
    "i18next": "^23.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.10.0",
    "resend": "^3.5.0"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "playwright": "^1.42.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vite": "^5.1.0"
  }
}
